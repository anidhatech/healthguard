# HealthGuard configuration. Copy to `.env` (or run `pnpm env:setup`, which
# also generates fresh JWT keys). NEVER commit `.env`: it is git-ignored.
# DEMO • SYNTHETIC HEALTH DATA • NOT FOR CLINICAL USE

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Human-readable logs for local development (JSON when false).
LOG_PRETTY=true

# --- App URLs ----------------------------------------------------------------
# Where people open the web app.
APP_BASE_URL=http://localhost:3000
# The API, as the browser and tools see it (Swagger at /api/docs).
API_PUBLIC_URL=http://localhost:4000
API_PORT=4000
# Where the web server forwards /api/* (server side). In Docker: http://api:4000
API_INTERNAL_URL=http://localhost:4000
# Comma-separated browser origins allowed to call the API directly (defaults to APP_BASE_URL).
# CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# --- Database and cache --------------------------------------------------------
DATABASE_URL=postgresql://healthguard:healthguard@localhost:5432/healthguard
# Used only by the integration tests (they reset it).
TEST_DATABASE_URL=postgresql://healthguard:healthguard@localhost:5432/healthguard_test
REDIS_URL=redis://localhost:6379

# --- Demo mode -----------------------------------------------------------------
# Demo mode shows the synthetic-data banner everywhere and enables the
# DEMO / DEVELOPMENT quick sign-in. It is not production authentication.
DEMO_MODE=true
DEMO_AUTH_ENABLED=true
# Password for the seeded demo accounts (email + password sign-in also works).
DEMO_ACCOUNT_PASSWORD=HealthGuard-Demo-2026
PASSWORD_LOGIN_ENABLED=true

# --- Sessions ------------------------------------------------------------------
# Ed25519 key pair (PEM, or base64 of the PEM). `pnpm env:setup` fills these.
# Left empty in development, the API generates a temporary pair at start-up.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Key for hashing IP addresses and user agents in audit rows.
IDENTIFIER_HASH_KEY=

# --- AI ------------------------------------------------------------------------
# demo: deterministic, offline, no key needed (default).
# anthropic: Claude via the Anthropic API; falls back to demo on any failure.
AI_PROVIDER=demo
# Read from the environment only. Never hardcode it, never commit it.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_FAST_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=30000
AI_FALLBACK_TO_DEMO=true

# --- Rate limits (per minute) ---------------------------------------------------
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_MINUTE=10

# --- Storage (document upload is the next phase) -------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# --- Interoperability (not connected in this phase) -----------------------------
ABDM_ADAPTER=disabled
