{
  "name": "@healthguard/api",
  "version": "0.1.0",
  "private": true,
  "description": "HealthGuard API (NestJS). DEMO • SYNTHETIC HEALTH DATA • NOT FOR CLINICAL USE",
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:reset": "prisma migrate reset --force",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@healthguard/ai": "workspace:*",
    "@healthguard/clinical": "workspace:*",
    "@healthguard/shared": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "6.3.11",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@healthguard/config": "workspace:*",
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.13",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tsc-watch": "7.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
