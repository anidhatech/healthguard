// HealthGuard domain model (Phase 1 foundation). Source of truth for the database.
// DEMO • SYNTHETIC HEALTH DATA • NOT FOR CLINICAL USE
// Prisma ORM 7.10.x, PostgreSQL 17, UUIDv7 keys, timestamptz everywhere

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in the Prisma config file, not here.
}

